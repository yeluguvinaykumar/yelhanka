# ---------------------------------------------------------------------------
# Tasty Treasures — environment
# Copy this file to `.env.local` for development, and add the same values in
# Vercel → Project → Settings → Environment Variables for production.
# ---------------------------------------------------------------------------

# ------------------------------- Admin -------------------------------------
# Password for /admin. Change before deploying anywhere public.
ADMIN_PASSWORD=tasty-treasures

# Long random string used to sign the admin session cookie (HMAC).
# Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# Protects /api/cron/sync-shipments. Vercel Cron sends this as a Bearer token.
# Generate with: openssl rand -hex 32
CRON_SECRET=change-me-to-a-random-cron-secret

# ------------------------------- Site --------------------------------------
# Public site origin, used for metadata, canonical URLs, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://tastytreasures.example

# --------------------------- MongoDB Atlas ---------------------------------
# Create a free cluster at https://cloud.mongodb.com, add a database user and
# allow Vercel access (0.0.0.0/0 or Vercel's IP ranges), then paste the
# connection string below. Without this the app falls back to local JSON files
# and data will NOT survive on Vercel.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=tasty-treasures

# ----------------------------- Cloudinary ----------------------------------
# Sign up at https://cloudinary.com. Copy the cloud name, API key and API secret
# from Dashboard → Product Environment Credentials. Uploads are signed on the
# server, so the secret is never exposed to the browser.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ------------------------------ Delhivery ----------------------------------
# Get the token from Delhivery One → Settings → API Setup, and ask your account
# manager to register the pickup warehouse below.
DELHIVERY_API_TOKEN=your-delhivery-api-token
DELHIVERY_CLIENT=your-delhivery-client-name

# "production" (default) or "staging" for Delhivery's test environment.
DELHIVERY_ENV=production

# "Surface" (default) or "Express".
DELHIVERY_SHIPPING_MODE=Surface

# Pickup warehouse. DELHIVERY_PICKUP_NAME must match Delhivery's registered
# warehouse name exactly (case-sensitive) or shipment creation is rejected.
DELHIVERY_PICKUP_NAME=Your Warehouse Name
DELHIVERY_PICKUP_ADDRESS=Street address of the warehouse
DELHIVERY_PICKUP_CITY=Kochi
DELHIVERY_PICKUP_PINCODE=682016
DELHIVERY_PICKUP_PHONE=919876543210
DELHIVERY_PICKUP_COUNTRY=India

# ---------------------------------------------------------------------------
# Contact details, WhatsApp number, shipping thresholds and storefront copy
# are stored in MongoDB (or data/content.json locally) and edited from
# Admin → Content. The seed values in lib/content.ts are placeholders:
# replace the WhatsApp number, email, phone and address before going live.
# ---------------------------------------------------------------------------
